{
  "name": "claudio-futebol-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Treinador digital de futebol para o navegador do celular, com processamento local e sem dependências em tempo de execução.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs --dir dist --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e",
    "icons": "node scripts/make-icons.mjs",
    "pose:prepare": "node scripts/prepare-pose.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "eslint": "10.1.0",
    "playwright": "1.56.1",
    "prettier": "3.8.1",
    "typescript": "6.0.2"
  }
}
